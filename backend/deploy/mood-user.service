[Unit]
Description=Mood PWA and Telegram bot (user service, Cloudflare Quick Tunnel)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/mood
Environment=API_HOST=127.0.0.1
Environment=API_PORT=3000
Environment=NODE_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
LimitNOFILE=8192
ExecStart=%h/mood/backend/deploy/mood-user-stack.sh
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
