# /etc/systemd/system/mood.service
# Приложение Mood: REST API + фоновый нотификатор + Web Push + отчёты.
# Telegram-бот сюда НЕ входит — он живёт отдельным юнитом mood-bot.service.
#
# Установка:
#   npm ci && npm run build
#   useradd --system --home /opt/mood --shell /usr/sbin/nologin mood
#   chown -R mood:mood /opt/mood && chmod 700 /opt/mood/db/data && chmod 600 /opt/mood/.env
#   cp backend/deploy/mood.service /etc/systemd/system/mood.service
#   systemctl daemon-reload && systemctl enable --now mood

[Unit]
Description=Mood PWA Service (API + notifications)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Сервис не нуждается в root: он пишет только в db/data и ходит по сети.
# Под root кража любой уязвимости давала сразу полный контроль над VPS.
User=mood
Group=mood
WorkingDirectory=/opt/mood

# Все создаваемые файлы — только для владельца. Без этого база с зашифрованными
# паролями и живыми сессиями читается любым локальным пользователем.
UMask=0077

# --max-old-space-size: потолок для кучи V8. Без него Node подбирает лимит по
# объёму RAM, и на VPS ядро доводит процесс до SIGKILL от OOM-killer'а — в
# журнале будет только «Killed», без причины. С флагом V8 сам останавливает
# процесс раньше, печатая «FATAL ERROR: ... JavaScript heap out of memory».
#
# 512 МБ, а не 768: прод RU — 830 МБ RAM (см. info.md). При 768 МБ кучи плюс
# RSS, sharp и буферы процесс упирается в физическую память раньше, чем в
# cgroup. Те же значения продублированы в mood-hardening.conf; здесь они
# остаются на случай, если drop-in не установлен.
ExecStart=/usr/bin/node --max-old-space-size=512 dist/app.js

# Мягкий лимит памяти cgroup. Если превышен — SIGKILL и рестарт.
MemoryMax=700M

# Перезапуск при любом выходе, а не только при ошибке.
Restart=always
RestartSec=10

EnvironmentFile=/opt/mood/.env
Environment=NODE_ENV=production

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mood

[Install]
WantedBy=multi-user.target
