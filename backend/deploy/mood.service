# /etc/systemd/system/mood.service
# Установка:
#   npm ci && npm run build
#   useradd --system --home /opt/mood --shell /usr/sbin/nologin mood
#   chown -R mood:mood /opt/mood && chmod 700 /opt/mood/data && chmod 600 /opt/mood/.env
#   cp backend/deploy/mood.service /etc/systemd/system/mood.service
#   systemctl daemon-reload && systemctl enable --now mood

[Unit]
Description=Mood Telegram Schedule Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Бот не нуждается в root: он только пишет в /opt/mood/data и ходит по сети.
# Под root кража любой уязвимости давала сразу полный контроль над VPS.
User=mood
Group=mood
WorkingDirectory=/opt/mood

# Все создаваемые файлы — только для владельца. Без этого data/users.json с
# зашифрованными паролями и живыми сессиями читает любой локальный пользователь.
UMask=0077

# --max-old-space-size=256: потолок для кучи V8. Без него Node подбирает лимит
# по объёму RAM, и на VPS с 512 МБ ядро доведёт процесс до SIGKILL от
# OOM-killer'а — в журнале будет только «Killed», без причины.
# С флагом V8 сам останавливает процесс раньше, на RSS ~300 МБ, печатая
# «FATAL ERROR: ... JavaScript heap out of memory». Это даёт две вещи:
#   1. причина падения видна в journalctl;
#   2. у MemoryMax=400M остаётся запас, и OOM-killer не нужен.
ExecStart=/usr/bin/node --max-old-space-size=256 dist/bot.js

# Мягкий лимит памяти cgroup. Если превышен — SIGKILL и рестарт.
# Держим выше пикового RSS бота (~300 МБ), но ниже 512 МБ физической памяти:
# запас нужен самому systemd и sshd.
MemoryMax=400M

# Долгий опрос Telegram: перезапуск при любом выходе, а не только при ошибке.
Restart=always
RestartSec=10

EnvironmentFile=/opt/mood/.env
Environment=NODE_ENV=production

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mood

[Install]
WantedBy=multi-user.target