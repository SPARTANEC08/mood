{
  "name": "hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild bot.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/bot.js --log-level=warning",
    "start": "node dist/bot.js",
    "bot": "node dist/bot.js",
    "dev": "tsx watch bot.ts",
    "tsx": "tsx bot.ts",
    "reset:users": "tsx scripts/reset-users.ts",
    "test:notifier": "tsx scripts/test-notifier.ts",
    "test:html": "tsx scripts/test-html-views.ts",
    "test:isolation": "tsx scripts/test-group-isolation.ts",
    "check:files": "tsx scripts/check-files.ts",
    "test:all": "tsx scripts/test-bars-login-hash.ts && tsx scripts/test-pwa-auth.ts && tsx scripts/test-pwa-routes.ts && tsx scripts/test-bars-snapshot.ts && tsx scripts/test-group-isolation.ts && tsx scripts/test-notifier.ts && tsx scripts/test-grades-calc.ts && tsx scripts/test-html-views.ts && npm run test:files && npm run test:notifications",
    "test:grades-calc": "tsx scripts/test-grades-calc.ts",
    "test:auth": "tsx scripts/test-bars-auth.ts",
    "test:client": "tsx scripts/test-bars-client.ts",
    "test:grades": "tsx scripts/test-grades.ts",
    "test:attendance": "tsx scripts/test-attendance.ts",
    "test:info": "tsx scripts/test-info.ts",
    "test:scraper": "tsx scripts/test-bars-scraper.ts",
    "test:scraper:login": "tsx scripts/test-bars-scraper.ts --login",
    "test:mail": "tsx scripts/test-mail-auth.ts",
    "test:mail:fetch": "tsx scripts/test-mail-fetch.ts",
    "test:owa": "tsx scripts/test-owa-mail.ts",
    "lint": "tsc --noEmit",
    "api": "tsx src/server/index.ts",
    "check:layout": "npm run pwa:build && node scripts/check-layout.mjs",
    "test:pwa-auth": "tsx scripts/test-pwa-auth.ts",
    "test:pwa-routes": "tsx scripts/test-pwa-routes.ts",
    "test:files": "tsx scripts/test-file-roundtrip.ts",
    "pwa:setup": "node scripts/pwa-setup.mjs",
    "pwa:build": "cd pwa && npm run icons && npm run build",
    "pwa:dev": "cd pwa && npm run dev",
    "reset:db": "tsx scripts/reset-db.ts",
    "test:bars-login-hash": "tsx scripts/test-bars-login-hash.ts",
    "test:snapshot": "tsx scripts/test-bars-snapshot.ts",
    "test:notifications": "tsx scripts/test-notifications-toggle.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@types/tough-cookie": "^4.0.5",
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "imapflow": "^2.2.8",
    "mailparser": "^3.9.36",
    "sharp": "^0.35.5",
    "tough-cookie": "^6.0.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.23",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
