# Шаблон секретов. Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ AES-256-GCM для кредов БАРС: 64 hex-символа.
ENCRYPTION_SECRET_KEY=

# Секрет для PWA-токенов: 64 hex-символа (npm run pwa:setup). Отдельный ключ.
PWA_AUTH_SECRET=

# Публичный HTTPS-адрес PWA: кнопка «Открыть приложение», CORS, deep link,
# а также host для TWA/APK (должен совпадать с доменом в assetlinks.json).
PWA_URL=

# REST API включается только при заданном порту
API_PORT=3000
API_HOST=127.0.0.1

# Telegram ID администраторов бота (через запятую). Их нельзя снять из бота:
# это страховка от потери доступа. Остальных назначают через админ-меню.
ADMIN_TELEGRAM_IDS=

# Токен доступа к странице статистики /dev/ (ссылка в админ-меню бота)
DEV_STATS_TOKEN=

# --- Web Push (VAPID) ----------------------------------------------------------
# Ключи для пушей в PWA. Сгенерировать один раз:
#   npx web-push generate-vapid-keys
# Публичный ключ отдаётся браузеру, приватный не покидает сервер.
# Не заданы — push-канал выключен, Telegram продолжает работать.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца ключей для push-сервисов (mailto: или https:).
VAPID_SUBJECT=mailto:noreply@mood.local

# --- APK (TWA) -----------------------------------------------------------------
# Пароли keystore для сборки APK. НЕ коммитить. Потеря keystore или пароля =
# новый APK встанет как ДРУГОЕ приложение, обновить поверх нельзя.
# Сгенерировать keystore: npm run apk:keystore
APK_KEYSTORE_PASSWORD=
APK_KEY_ALIAS=mood
APK_KEY_PASSWORD=

# applicationId. Задаётся один раз и навсегда: смена = переустановка приложения.
APK_PACKAGE_ID=ru.mpei.mood
