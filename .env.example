# Шаблон секретов. Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает (см. .gitignore).
#
# Файлов два, и они не должны быть общими:
#   .env       — приложение (dist/app.js): ключи, API, push;
#   bot.env    — бот (dist/bot.js): только токен и адрес приложения.
# У бота не должно быть ENCRYPTION_SECRET_KEY и PWA_AUTH_SECRET: ему они не
# нужны, а утечка бандла не должна давать доступ к данным студентов.

# =============================================================================
# Приложение: API + нотификатор + Web Push + отчёты (dist/app.js)
# =============================================================================

# Ключ AES-256-GCM для кредов БАРС: 64 hex-символа.
ENCRYPTION_SECRET_KEY=

# Секрет для PWA-токенов: 64 hex-символа (npm run pwa:setup). Отдельный ключ.
PWA_AUTH_SECRET=

# Публичный HTTPS-адрес PWA: CORS, ссылки, а также host для TWA/APK
# (должен совпадать с доменом в assetlinks.json).
PWA_URL=

# REST API включается только при заданном порту
API_PORT=3000
API_HOST=127.0.0.1

# Логины БАРС администраторов через запятую. Хэшируются при старте; админка
# PWA работает без Telegram. Env-админов нельзя снять из интерфейса.
ADMIN_BARS_LOGINS=

# --- Web Push (VAPID) ----------------------------------------------------------
# Ключи для пушей в PWA. Сгенерировать один раз:
#   npx web-push generate-vapid-keys
# Публичный ключ отдаётся браузеру, приватный не покидает сервер.
# Не заданы — push-канал выключен, остальные разделы работают.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца ключей для push-сервисов (mailto: или https:).
VAPID_SUBJECT=mailto:noreply@mood.local

# =============================================================================
# Бот: только ссылки и APK (dist/bot.js, отдельный bot.env)
# =============================================================================

# Токен бота от @BotFather. Больше боту ничего не нужно.
TELEGRAM_BOT_TOKEN=

# Тот же публичный адрес: кнопки установки и ссылка на инструкцию.
# PWA_URL=

# Пост с последней версией APK для кнопки «Скачать из Telegram».
# Меняется после релиза без пересборки бота.
TELEGRAM_APK_POST_URL=https://t.me/mood_mpei/15

# --- APK (TWA) -----------------------------------------------------------------
# Пароли keystore для сборки APK. НЕ коммитить. Потеря keystore или пароля =
# новый APK встанет как ДРУГОЕ приложение, обновить поверх нельзя.
# Сгенерировать keystore: npm run apk:keystore
APK_KEYSTORE_PASSWORD=
APK_KEY_ALIAS=mood
APK_KEY_PASSWORD=

# applicationId. Задаётся один раз и навсегда: смена = переустановка приложения.
APK_PACKAGE_ID=ru.mpei.mood
