# Секреты — никогда не в git
.env

# Локальная шпаргалка с доступами (серверы, пароли, команды)
info.md
.env.*
!.env.example
*.env.vps
bars-session-debug.json
.bars-session-debug.json
.bars-debug-*.html
.bars-debug-*.json

# Данные приложения: персональные, с зашифрованными кредями БАРС.
# Каталог сохраняется в репозитории только пустой заглушкой .gitkeep;
# всё содержимое (users.json, файлы, снимки, отчёты) — вне git.
db/data/*
!db/data/.gitkeep

# Зависимости
node_modules/
__pycache__/

# Сборка
dist/
build/
tmp/

# APK (TWA): ключ подписи и артефакты сборки — НИКОГДА в git.
# Потеря keystore = нельзя обновить установленное приложение (сменится подпись).
mood.keystore
*.keystore
*.jks
apk/
# Копия APK для самостоятельного Telegram-бота. Бинарник не коммитим:
# её создаёт `npm run apk:bot` (и deploy.sh) из apk/.
tg/apk/*.apk
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/keystore.properties

# Служебное
.DS_Store
*.log
bot-subscribers.json

# Веб-версия (PWA)
pwa/node_modules/
pwa/dist/
