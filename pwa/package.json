{
  "name": "mood-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Приложение Mood для браузера: ставится на домашний экран и работает как PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/copy-apk.mjs && vite build && node scripts/inject-sw-version.mjs && node scripts/precompress.mjs",
    "preview": "vite preview --port 4173",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.54.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^7.7.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
